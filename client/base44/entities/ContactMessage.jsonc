{
  "name": "ContactMessage",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "visitor_ip": {
      "type": "string"
    },
    "browser": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "read",
        "archived"
      ],
      "default": "new"
    }
  },
  "required": [
    "full_name",
    "email",
    "message"
  ]
}